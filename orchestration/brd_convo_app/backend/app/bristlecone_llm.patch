+"""
+bristlecone_llm.py — Unified LLM connector for the BRD tool.
+
+Supported providers
+  bristlecone  Azure OpenAI via DefaultAzureCredential (default).
+               Requires `az login` (dev) or Managed Identity (prod).
+               No API key needed.
+  openai       Standard OpenAI via OPENAI_API_KEY.
+
+Configure in .env
+  LLM_PROVIDER            bristlecone | openai      (default: bristlecone)
+
+  # Bristlecone / Azure OpenAI
+  AZURE_ENDPOINT          https://bcnllmaistudious2.services.ai.azure.com
+  AZURE_API_VERSION       2025-01-01-preview
+  AZURE_DEPLOYMENT        gpt-5.5                   (default for all roles)
+  AZURE_CHAT_DEPLOYMENT   override for chat/generation calls
+  AZURE_VISION_DEPLOYMENT override for vision/image analysis
+  AZURE_MINI_DEPLOYMENT   override for lightweight/keyword tasks
+  AZURE_EMBED_DEPLOYMENT  override for embeddings
+
+  # Standard OpenAI  (only needed when LLM_PROVIDER=openai)
+  OPENAI_API_KEY          sk-...
+  OPENAI_MODEL            gpt-4.1
+  VISION_MODEL            gpt-4.1
+  OPENAI_MINI_MODEL       gpt-4.1-mini
+  EMBED_MODEL             text-embedding-3-small
+
+Usage
+  from bristlecone_llm import get_connector
+
+  connector = get_connector()
+  client    = connector.get_client()              # OpenAI-compatible client
+  model     = connector.resolve_model("vision")   # deployment / model name
+  text      = connector.chat_complete_text(messages=[...], role="chat")
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from typing import List, Optional
+
+logger = logging.getLogger(__name__)
+
+# ── Defaults ───────────────────────────────────────────────────────────────────
+_AZURE_ENDPOINT_DEFAULT    = "https://bcnllmaistudious2.services.ai.azure.com"
+_AZURE_API_VERSION_DEFAULT = "2025-01-01-preview"
+_AZURE_DEPLOYMENT_DEFAULT  = "gpt-5.5"
+
+
+class BristleconeLLMConnector:
+    """
+    OpenAI-compatible LLM connector that routes to either:
+      • Bristlecone Azure OpenAI  (DefaultAzureCredential, no API key required)
+      • Standard OpenAI           (OPENAI_API_KEY)
+
+    A single instance is reused throughout the process — get it via
+    ``get_connector()`` rather than constructing directly.
+    """
+
+    VALID_PROVIDERS = ("bristlecone", "openai")
+
+    def __init__(self, provider: Optional[str] = None):
+        raw = (provider or os.getenv("LLM_PROVIDER", "bristlecone")).lower().strip()
+        if raw not in self.VALID_PROVIDERS:
+            logger.warning(
+                "BristleconeLLMConnector: unknown LLM_PROVIDER=%r — defaulting to 'bristlecone'.",
+                raw,
+            )
+            raw = "bristlecone"
+        self.provider = raw
+        self._client  = None
+        logger.info("BristleconeLLMConnector initialised: provider=%s", self.provider)
+
+    # ── Client factory ─────────────────────────────────────────────────────────
+
+    def get_client(self):
+        """Return a cached OpenAI-compatible client (AzureOpenAI or OpenAI)."""
+        if self._client is None:
+            if self.provider == "bristlecone":
+                self._client = self._make_azure_client()
+            else:
+                self._client = self._make_openai_client()
+        return self._client
+
+    def _make_azure_client(self):
+        try:
+            from azure.identity import DefaultAzureCredential, get_bearer_token_provider
+        except ImportError:
+            raise RuntimeError(
+                "azure-identity is required for the Bristlecone provider.\n"
+                "Install with: pip install azure-identity\n"
+                "Then authenticate with: az login --tenant <tenant-id>"
+            )
+        try:
+            from openai import AzureOpenAI
+        except ImportError:
+            raise RuntimeError("openai package is required. Run: pip install openai")
+
+        ssl_verify = os.getenv("OPENAI_SSL_VERIFY", "false").lower() not in ("false", "0", "no")
+        http_kwargs: dict = {}
+        try:
+            import httpx as _httpx
+            http_kwargs["http_client"] = _httpx.Client(verify=ssl_verify, timeout=60.0)
+        except ImportError:
+            pass
+
+        endpoint    = os.getenv("AZURE_ENDPOINT",    _AZURE_ENDPOINT_DEFAULT)
+        api_version = os.getenv("AZURE_API_VERSION", _AZURE_API_VERSION_DEFAULT)
+
+        token_provider = get_bearer_token_provider(
+            DefaultAzureCredential(),
+            "https://cognitiveservices.azure.com/.default",
+        )
+
+        logger.info(
+            "BristleconeLLMConnector: Azure endpoint=%s api_version=%s",
+            endpoint, api_version,
+        )
+        return AzureOpenAI(
+            azure_endpoint=endpoint,
+            azure_ad_token_provider=token_provider,
+            api_version=api_version,
+            max_retries=1,
+            timeout=60.0,
+            **http_kwargs,
+        )
+
+    def _make_openai_client(self):
+        try:
+            from openai import OpenAI
+        except ImportError:
+            raise RuntimeError("openai package is required. Run: pip install openai")
+
+        ssl_verify = os.getenv("OPENAI_SSL_VERIFY", "false").lower() not in ("false", "0", "no")
+        http_kwargs: dict = {}
+        try:
+            import httpx as _httpx
+            http_kwargs["http_client"] = _httpx.Client(verify=ssl_verify, timeout=60.0)
+        except ImportError:
+            pass
+
+        return OpenAI(
+            api_key=os.getenv("OPENAI_API_KEY"),
+            max_retries=1,
+            timeout=60.0,
+            **http_kwargs,
+        )
+
+    # ── Model / deployment name resolution ────────────────────────────────────
+
+    def resolve_model(self, role: str = "chat") -> str:
+        """
+        Map a logical role to the deployment name (Azure) or model name (OpenAI).
+
+        Roles:
+          "chat"   — general chat / document generation
+          "vision" — multimodal vision analysis
+          "mini"   — lightweight tasks (keyword extraction, classification)
+          "embed"  — text embeddings
+        """
+        default = os.getenv("AZURE_DEPLOYMENT", _AZURE_DEPLOYMENT_DEFAULT)
+
+        if self.provider == "bristlecone":
+            table = {
+                "chat":   os.getenv("AZURE_CHAT_DEPLOYMENT",   default),
+                "vision": os.getenv("AZURE_VISION_DEPLOYMENT", default),
+                "mini":   os.getenv("AZURE_MINI_DEPLOYMENT",   default),
+                "embed":  os.getenv("AZURE_EMBED_DEPLOYMENT",  "text-embedding-3-small"),
+            }
+        else:
+            table = {
+                "chat":   os.getenv("OPENAI_MODEL",       "gpt-4.1"),
+                "vision": os.getenv("VISION_MODEL",       "gpt-4.1"),
+                "mini":   os.getenv("OPENAI_MINI_MODEL",  "gpt-4.1-mini"),
+                "embed":  os.getenv("EMBED_MODEL",        "text-embedding-3-small"),
+            }
+        return table.get(role, table["chat"])
+
+    # ── Convenience wrappers ──────────────────────────────────────────────────
+
+    def chat_complete(self, messages: list, role: str = "chat", **kwargs):
+        """Chat completion — returns the raw API response object."""
+        model = kwargs.pop("model", None) or self.resolve_model(role)
+        return self.get_client().chat.completions.create(
+            model=model, messages=messages, **kwargs
+        )
+
+    def chat_complete_text(self, messages: list, role: str = "chat", **kwargs) -> str:
+        """Chat completion — returns just the assistant text string."""
+        return self.chat_complete(messages, role=role, **kwargs).choices[0].message.content.strip()
+
+    def embed(self, texts: List[str], **kwargs) -> List[List[float]]:
+        """Generate embeddings — returns a list of float vectors."""
+        model = kwargs.pop("model", None) or self.resolve_model("embed")
+        response = self.get_client().embeddings.create(model=model, input=texts, **kwargs)
+        return [item.embedding for item in response.data]
+
+    def __repr__(self) -> str:
+        return f"BristleconeLLMConnector(provider={self.provider!r})"
+
+
+# ── Module-level singleton ─────────────────────────────────────────────────────
+
+_connector: Optional[BristleconeLLMConnector] = None
+
+
+def get_connector(provider: Optional[str] = None) -> BristleconeLLMConnector:
+    """Return the process-wide connector singleton.
+
+    Reads LLM_PROVIDER from the environment on first call.
+    Pass ``provider`` explicitly only to override (e.g. in tests).
+    """
+    global _connector
+    if _connector is None or provider is not None:
+        _connector = BristleconeLLMConnector(provider=provider)
+    return _connector
+
+
+def reset_connector() -> None:
+    """Force a fresh connector on the next get_connector() call (useful in tests)."""
+    global _connector
+    _connector = None
