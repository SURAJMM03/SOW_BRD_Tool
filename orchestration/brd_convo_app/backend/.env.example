# ==== Your account (created automatically on first run) ====
# Set this to YOUR OWN email before first launch. On first startup the app
# creates an admin account for this address. Leave ADMIN_PASSWORD unset —
# a one-time password is generated and printed once to the terminal.
ADMIN_EMAIL=you@bristlecone.com
# ADMIN_PASSWORD=

# ==== Document Generation — LLM provider ====
# Which LLM powers section generation: "azure" (default) or "anthropic".
LLM_PROVIDER=azure

# ---- Azure OpenAI (used when LLM_PROVIDER=azure) ----
# Auth is via Azure AD (DefaultAzureCredential) — run `az login` on the machine
# with a Bristlecone account that has access to the "ai-adoption-coe" Azure AI
# resource. No API key needed. Override these only if your deployment differs.
AZURE_OPENAI_ENDPOINT=https://bcnllmaistudious2.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Corporate proxy intercepts HTTPS with a cert Azure's SDK won't trust —
# needed on most Bristlecone machines.
AZURE_SSL_VERIFY=false
# SOW/BRD generation can take longer than the 90s client default on a
# reasoning model; raise the timeout and allow one automatic retry.
AZURE_OPENAI_TIMEOUT=300
AZURE_OPENAI_GEN_ATTEMPTS=2

# ---- Anthropic / Claude (used only when LLM_PROVIDER=anthropic) ----
CLAUDE_API_KEY="your-anthropic-api-key-here"
# Switch between Sonnet and Haiku by changing CLAUDE_MODEL only — no code changes needed
# Sonnet (default, higher quality):  claude-sonnet-4-5
# Haiku  (faster, lower cost):       claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-4-5

# ==== SSL / Corporate proxy (SSL inspection) ====
# If you see "Connection error" or "certificate verify failed" when generating,
# your corporate network is intercepting HTTPS with a self-signed certificate.
#
# Option A (recommended): point to your organisation's root CA PEM file.
#   Export from Windows: certmgr.msc → Trusted Root CAs → your CA → Export
#   → Base-64 encoded X.509 (.CER) → rename to .pem
# CLAUDE_CA_BUNDLE=C:/certs/corp_root_ca.pem
#
# Option B: disable SSL verification (quick bypass on a private/trusted network).
# CLAUDE_SSL_VERIFY=false

# ==== Embeddings / Vision / Keyword extraction — OpenAI ====
# Optional: only needed for image-vision extraction and if you switch
# SEARCH_BACKEND below to "semantic". Leave the placeholder if you don't
# have an OpenAI key yet — bm25 search and Azure-based generation work fine
# without it.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_MINI_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1 
# Embedding model — must match the model used when chunks were first indexed
EMBED_MODEL=text-embedding-3-small

# ==== Search backend ====
# semantic = OpenAI embeddings + cosine similarity (requires OPENAI_API_KEY)
# bm25     = keyword matching (no API cost) 
SEARCH_BACKEND=bm25

# ==== Output ====
BRD_OUTPUT_DIR=output

# ==== Web tools (your MCP web tools FastAPI) ====
MCP_WEBTOOLS_BASE_URL=http://localhost:8000 
MCP_WEBTOOLS_MAX_RESULTS=5 
MCP_WEBTOOLS_MAX_CHARS=12000 

# ==== Serper / SSL (only if your web tools server needs it) ====
SERPER_API_KEY=your-serper-api-key-here
# If you're behind SSL interception, point requests to corporate root CA bundle:
# REQUESTS_CA_BUNDLE=C:\certs\corp-root.pem  

AGENT_ADAPTER=app.agent_adapter   