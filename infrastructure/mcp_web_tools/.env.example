# ============================================================================
# MCP FastAPI Server Configuration
# ============================================================================

# FastAPI Server Settings
MCP_FASTAPI_HOST=0.0.0.0
MCP_FASTAPI_PORT=8000
MCP_FASTAPI_RELOAD=false

# ============================================================================
# MCP Client Configuration (for the FastAPI server to connect to MCP tools)
# ============================================================================

# Command to run the MCP tools server (stdio mode)
MCP_WEBTOOLS_COMMAND=uvx
MCP_WEBTOOLS_ARGS=mcp-web-tools

# Tool behavior settings
MCP_WEBTOOLS_MAX_RESULTS=5
MCP_WEBTOOLS_MAX_CHARS=12000

# API Keys (required for web search functionality)
BRAVE_SEARCH_API_KEY=your_brave_api_key_here
# PERPLEXITY_API_KEY=your_perplexity_key_here  # Optional alternative

# ============================================================================
# BRDGenAgent Configuration (HTTP client mode)
# ============================================================================

# Base URL for the MCP FastAPI server
MCP_WEBTOOLS_BASE_URL=http://localhost:8000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Agent Settings
AGENT_RECURSION_LIMIT=50
BRD_OUTPUT_DIR=output

# serper config
SERPER_API_KEY=your_serper_api_key_here
