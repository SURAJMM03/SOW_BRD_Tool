# kinaxis_http_server.py's built-in .env auto-discovery doesn't reliably find
# the backend's .env from this folder, so this MCP server keeps its own copy
# of the couple of keys it needs. Copy this file to .env and fill it in.

# serper = web search via serper.dev (free tier, https://serper.dev) — default,
#          no OpenAI key required.
# openai = web search via OpenAI's own tools (needs OPENAI_API_KEY below).
WEB_SEARCH_BACKEND=serper

SERPER_API_KEY=your-serper-api-key-here

# Only needed if WEB_SEARCH_BACKEND=openai above.
OPENAI_API_KEY=your-openai-api-key-here

# Corporate proxy intercepts HTTPS with a cert the SDKs won't trust by default.
# REQUESTS_CA_BUNDLE=C:\certs\corp-root.pem
